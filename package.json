{
  "name": "netflim",
  "version": "1.0.0",
  "description": "NETFLIM streaming UI with an Express, MongoDB and Cloudinary backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"nodemon server.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "nodemon server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.9",
    "vite": "^6.3.5"
  }
}
